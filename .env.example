# ==============================================================================
# SpecGuard — Production Offline Environment Configuration Template
# ==============================================================================
# Copy this file to .env on the deployment machine to configure custom runtime
# parameters. All variables have sensible, hardened offline defaults.
# ==============================================================================

# Application Environment Mode ('production', 'local')
SPECGUARD_ENV=production

# Server Binding Interface (0.0.0.0 binds to all available LAN interfaces)
SPECGUARD_HOST=0.0.0.0

# HTTP Port (Default: 8765)
SPECGUARD_PORT=8765

# Persistent Data Storage Path inside Container or Host
SPECGUARD_DATA_DIR=/app/data

# Optional Custom CORS LAN Origins (Comma-separated)
# Default allows localhost and all RFC 1918 private subnets (192.168.*, 10.*, 172.16-31.*)
# SPECGUARD_CORS_ORIGINS=http://192.168.1.100:8765,http://localhost:8765

# System Tesseract Data Path
TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
