# ==============================================================================
# SpecGuard — Offline LAN Deployment Environment Configuration
# ==============================================================================
# Use this configuration template for deploying SpecGuard in a 100% offline,
# isolated LAN or intranet environment with zero external dependencies.
# ==============================================================================

# Server Network Configuration (binds to all LAN interfaces)
HOST=0.0.0.0
PORT=8765

# Execution Environment: 'local' (strict intranet / offline operation)
ENVIRONMENT=production
SPECGUARD_ENV=local

# Local Storage Directory Override (Optional, defaults to '<app_dir>/data')
# DATA_DIR=/var/data/specguard

# Local SQLite Database Path (Optional, defaults to '<app_dir>/data/specguard.db')
# DB_PATH=/var/data/specguard/specguard.db

# CORS Allowed LAN Origins (Optional, default allows private IP subnets: 192.168.*, 10.*, 172.16-31.*)
# SPECGUARD_CORS_ORIGINS=http://192.168.1.100:8765,http://localhost:8765

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
