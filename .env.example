# ==============================================================================
# DocReady — Environment Configuration Template
# ==============================================================================
# Use this template for setting environment variables on Render or local testing.
# Copy this file to .env for local overrides. DO NOT commit secrets to Git.
# ==============================================================================

# Server Network Configuration
# On Render, $PORT is dynamically provided by the platform (e.g. 10000).
PORT=10000
DOCREADY_HOST=0.0.0.0

# Execution Environment
# Options: 'local' (strict localhost binding), 'portable', 'render_demo'
DOCREADY_ENV=render_demo

# Web Mode
# Set to 1 to suppress desktop GUI (PySide6) pre-flight checks in headless environments.
DOCREADY_WEB_MODE=1

# Storage Directory Override (Optional)
# If using Render Persistent Disks, set to your mount point (e.g. /var/data/docready).
# Defaults to '<app_dir>/data' or '~/.docready/data'.
# DOCREADY_DATA_DIR=/var/data/docready

# CORS Allowed Origins (Optional)
# Comma-separated list of allowed origins.
# In 'render_demo' mode, '*.onrender.com' and localhost are enabled by default.
# DOCREADY_CORS_ORIGINS=https://docready.onrender.com,http://localhost:3000

# Logging Verbosity
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
