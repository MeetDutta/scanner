# ==============================================================================
# SpecGuard — Production Docker Build Ignore Rules
# Excludes development artifacts, caches, and large offline dataset packages
# Preserves bundled runtime models, rules, standards, templates, and UI assets
# ==============================================================================

# Git & Version Control
.git
.gitignore

# Virtual Environments
.venv
venv
ENV
env

# Python Caches & Compiled Bytecode
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.coverage
htmlcov/

# Build Artefacts & Packaging Caches
build/
dist/
*.egg-info/
*.spec

# Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# Mutable Runtime User Data (Mounted externally via ./data:/app/data)
data/
reports/
repository/

# Development Tests & Offline Benchmark Dataset (Included in offline package, not base image layer)
tests/
demo_samples/
SpecGuard-Dataset-v1/
SpecGuard-Docker-Offline/
benchmark_results/
training/data/

# Export Archives & Local Databases
*.tar
*.tar.gz
*.log
*.db
*.db-journal
*.db-wal
*.sqlite3
